{
  // Production template for single-VPS deploy. Copy to appsettings.Production.json
  // (git-ignored) or — better — set the same keys as environment variables:
  //   ConnectionStrings__Default, JWT__Key, JWT__Issuer, JWT__Audience,
  //   EmailOtp__SecretPepper, Smtp__Host, Smtp__Port, Smtp__Username, Smtp__Password, Smtp__FromEmail,
  //   GoogleAuth__ClientId, GoogleAuth__ClientSecret,
  //   Storage__Provider, Storage__LocalPath, AllowedOrigins__0,
  //   SeedOnStartup, Admin__Email, Admin__Password
  // The API fail-fasts at boot when JWT:Key is missing in Production.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=DarcomDb;User Id=darcom;Password=CHANGE_ME;TrustServerCertificate=True"
  },
  "JWT": {
    "Issuer": "Darcom",
    "Audience": "Darcom",
    "Key": "SET_VIA_ENV_32_CHARS_MIN",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "EmailOtp": {
    "ExpiryMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "SecretPepper": "SET_VIA_ENV_PEPPER"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "Username": "SET_VIA_ENV",
    "Password": "SET_VIA_ENV_APP_PASSWORD",
    "FromEmail": "no-reply@your-domain.com",
    "FromName": "Darcom Real Estate"
  },
  "GoogleAuth": {
    "ClientId": "SET_VIA_ENV_GOOGLE_CLIENT_ID",
    "ClientSecret": "SET_VIA_ENV_GOOGLE_CLIENT_SECRET",
    "RedirectUri": "https://www.your-domain.com/api/auth/google/callback",
    "FrontendBaseUrl": "https://www.your-domain.com"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "/var/darcom/uploads"
  },
  "AllowedOrigins": [ "https://www.your-domain.com" ],
  "SeedOnStartup": false,
  "Admin": {
    "FullName": "Darcom Admin",
    "Email": "admin@your-domain.com",
    "Password": "SET_VIA_ENV_THEN_ROTATE"
  }
}
