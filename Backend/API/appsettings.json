{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=DarcomDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JWT": {
    "Issuer": "Darcom",
    "Audience": "Darcom",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "EmailOtp": {
    "ExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "SecretPepper": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Darcom Real Estate"
  },
  "GoogleAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "",
    "FrontendBaseUrl": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "uploads"
  },
  "AllowedOrigins": [ "http://localhost:5173" ],
  "SeedOnStartup": false,
  "Hangfire": {
    "Enabled": true,
    "EnableDashboard": true,
    "ReadOnlyDashboardInProduction": false,
    "Queues": [ "critical", "emails", "default", "maintenance" ],
    "WorkerCount": 4,
    "RetryAttempts": 3,
    "ViewingReminderHoursBefore": [ 24, 1 ],
    "BookingReminderHoursBeforeStart": 24,
    "BookingReminderHoursBeforeEnd": 24,
    "PendingRequestAlertHours": 24,
    "PendingRequestEscalationHours": 48,
    "PendingMonitorCron": "0 * * * *",
    "OtpRetentionHours": 24,
    "OtpCleanupCron": "0 */6 * * *",
    "RefreshTokenRetentionDays": 30,
    "RefreshTokenCleanupCron": "0 3 * * *",
    "DailyReportCron": "0 8 * * *",
    "TimeZoneId": "Africa/Cairo",
    "PropertyPublishingCron": "*/5 * * * *",
    "ImageProcessing": {
      "Enabled": true,
      "MaxWidth": 1920,
      "ThumbnailWidth": 480,
      "Quality": 82
    }
  },
  "Admin": {
    "FullName": "Darcom Admin",
    "Email": "",
    "Password": ""
  }
}
